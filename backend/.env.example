DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
PROMPT_LOGGING_ENABLED=false
PROMPT_LOG_DIR=data/prompt_logs
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_FILE=data/jity.sqlite3
KNOWLEDGE_DIR=../knowledge
RULEBOOK_FILE=../RULEBOOK.md
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_PROVIDER=openai
IMAGE_MODEL=gpt-image-1.5
IMAGE_SIZE=1536x1024
BACKGROUNDS_DIR=data/backgrounds

# Fallbacks when the campaign does not specify its own budget.
MAX_TURNS_PER_SESSION=30
MAX_TURNS_PER_CAMPAIGN=50
