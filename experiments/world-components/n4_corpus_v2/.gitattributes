# Frozen v2 corpora are pinned by sha256 in holdout-v2-freeze.json /
# n5/test-freeze.json and checked by the trainers. Keep the committed LF
# bytes on every checkout so the guards hold under core.autocrlf=true.
corpus_v2/*.jsonl -text
corpus_v2/*.json -text
corpus_v2/n5/*.jsonl -text
corpus_v2/n5/*.json -text
train-v2-report.json -text
train-n5-report.json -text

# N4 v3/v3a experiment corpora and reports keep their archived LF bytes.
corpus_v3/*.jsonl -text
corpus_v3/*.json -text
corpus_v3a/*.jsonl -text
corpus_v3a/*.json -text
train-v3-report.json -text
train-v3a-report.json -text

# Per-file snapshot bytes (next-baseline); do not replace with a wildcard.
# Existing text blobs use explicit checkout EOL; newly tracked bytes use -text.
"build_statement_verify.py" -text
"build_target_pairs.py" -text
"review_statement_verify.py" -text
"train_verify_binary.py" -text
"verify_input.py" -text
build_statement_verify.py whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
build_target_pairs.py whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
train_verify_binary.py whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
