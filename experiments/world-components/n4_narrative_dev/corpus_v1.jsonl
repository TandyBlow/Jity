{"worldId": "w_fog_harbor", "id": "n4n-31", "title": "早市的鱼鳞", "facts": [{"factId": "f0", "kind": "moved", "entityId": "char_shen", "name": "沈砚", "from": "潮生巷", "to": "早市", "at": "早市", "source": {"field": "positionSet"}}, {"factId": "f1", "kind": "appearance_changed", "entityId": "char_atang", "name": "阿棠", "text": "围裙上又添了一层银亮鱼鳞", "at": "早市", "source": {"field": "appearanceChanges"}}, {"factId": "f2", "kind": "time", "entityId": null, "name": null, "amount": 7, "unit": "minute", "source": {"timeAdvance": true}}], "sceneBrief": {"locationId": "loc_market", "location": "早市·摊棚", "time": "清晨", "weather": "白汽，湿冷", "present": ["char_shen", "char_atang"], "props": ["银鳞鱼", "鱼筐", "干纸", "外袍"], "atmosphere": "鱼鳞反光，人流拥挤", "allowedElaboration": ["weather", "sensory", "gesture", "interiority"], "hiddenMotivation": []}, "perspective": {"type": "protagonist", "entityId": "char_shen", "at": "早市"}, "narrative": "早市的帆布棚下全是白汽，阿棠蹲在鱼筐边挑鱼，围裙上又添了一层银亮的鱼鳞。沈砚从潮生巷过来，在摊棚外站住；鱼尾拍起的水花溅到石板上，很快被来往的鞋底踩开。", "annotations": [], "sceneState": {"locationId": "loc_market", "locationPath": ["loc_market", "loc_market_stalls"], "time": "清晨", "weather": "白汽，湿冷", "wind": "低（棚下）", "light": "帆布棚下", "present": ["char_shen", "char_atang"], "visibleItems": ["item_fish", "item_fishbasket", "item_paper", "item_coat"], "atmosphere": "鱼鳞反光，人流拥挤"}, "grounding": [{"detail": "早市", "source": "loc_market", "value": "潮生巷尽头的鱼市"}, {"detail": "帆布棚", "source": "loc_market_stalls", "value": "帆布棚"}, {"detail": "白汽", "source": "loc_market_stalls", "value": "白汽"}, {"detail": "阿棠", "source": "char_atang", "value": "围裙上有鱼鳞"}, {"detail": "鱼筐", "source": "item_fishbasket", "value": "竹编鱼筐"}, {"detail": "鱼鳞", "source": "fact f1", "value": "围裙上又添了一层银亮鱼鳞"}, {"detail": "潮生巷", "source": "loc_alley", "value": "潮生巷"}, {"detail": "摊棚", "source": "loc_market_stalls", "value": "摊棚"}, {"detail": "石板", "source": "loc_market_stalls", "value": "石板"}], "timeNarrative": "vague", "characterContext": [{"entityId": "char_shen", "name": "沈砚", "personality": "