# Protocol artifacts are hashed byte-for-byte; checkout and commit must not
# rewrite line endings on any platform. See design/world-protocol/v2/.
design/world-protocol/** text eol=lf
frontend/src/lib/world-engine/contract-digest.json text eol=lf

# H2 evidence manifests bind file bytes, including the recorded orchestrator.
artifacts/h2-full-6b809dc-0cb1951/** text eol=lf
artifacts/h2-integration-d1d2de0/** text eol=lf

# The short browser evaluation records byte hashes for replay and review.
artifacts/b3-short/** text eol=lf
artifacts/rule-facts/** text eol=lf

# Windows reserved device names written by shell redirects (e.g. `>nul`).
# They cannot be checked out on Windows, so they must never be tracked.
nul -text

# D (components-logic) byte-binds its dev inputs/drafts, the generator and
# the review packet; checkout and commit must not rewrite line endings.
experiments/world-components-logic/** text eol=lf
artifacts/world-components-logic/** text eol=lf

# Preserve compressed evidence and archived model bytes exactly.
*.gz -text
*.jpg -text
artifacts/world-components-logic/model-archive-20261110/** -text

# User-authorized training backup (2026-11-10).
artifacts/world-components-logic/large-file-backup-20261110/*.part* filter=lfs diff=lfs merge=lfs -text
