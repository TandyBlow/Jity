 },
 "v08": {
  "set": "final24",
  "nFact": 3,
  "nSent": 3,
  "dupSent": 0,
  "innerRepeat": 0,
  "multiDe": 0,
  "sameSubjAdj": 0,
  "baRatio": 0.33,
