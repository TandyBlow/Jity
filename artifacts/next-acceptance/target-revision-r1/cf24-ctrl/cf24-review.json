   "unitId": "t22:f0",
   "sourceId": "t22",
   "kind": "appearance_changed",
   "text": "系泊绳的泥水结了一层白盐。",
   "factSupported": true,
   "independence": "independent",
   "flags": {
    "language": "所有格错位：系泊绳的泥水"
   }
  },
  {
   "unitId": "t22:f1",
   "sourceId": "t22",
   "kind": "appearance_changed",
   "text": "木桩上缠着的旧缆绳断了。",
   "factSupported": true,
   "independence": "independent",
   "flags": {}
  },
  {
   "unitId": "t22:f2",
   "sourceId": "t22",
   "kind": "outcome",
   "text": "顾行舟把缆绳重新绕上木桩。",
   "factSupported": true,
   "independence": "independent",
   "flags": {}
  },
  {
   "unitId": "t22:f3",
   "sourceId": "t22",
   "kind": "outcome",
   "text": "沈砚把系泊绳拖回岸上。",
   "factSupported": true,
   "independence": "independent",
   "flags": {}
  },
  {
   "unitId": "t23:f0",
   "sourceId": "t23",
   "kind": "appearance_changed",
   "text": "铜灯罩的玻璃上蒙了盐雾。",
   "factSupported": true,
   "independence": "independent",
   "flags": {}
  },
  {
   "unitId": "t23:f1",
   "sourceId": "t23",
   "kind": "appearance_changed",
   "text": "铁链的链环上结了锈。",
   "factSupported": true,
   "independence": "independent",
   "flags": {}
  },
  {
   "unitId": "t23:f2",
   "sourceId": "t23",
   "kind": "outcome",
   "text": "叶知微把灯罩擦得透亮。",
   "factSupported": true,
   "independence": "seen-fact",
   "flags": {}
  },
  {
   "unitId": "t23:f3",
   "sourceId": "t23",
   "kind": "outcome",
   "text": "沈砚换好塔顶的灯芯,铜灯罩不再发暗。",
   "factSupported": true,
   "independence": "independent",
   "flags": {}
  },
  {
   "unitId": "t24:f0",
   "sourceId": "t24",
   "kind": "appearance_changed",
   "text": "纸灯笼被风扯破一角。",
   "factSupported": true,
   "independence": "independent",
   "flags": {}
  },
  {
   "unitId": "t24:f1",
   "sourceId": "t24",
   "kind": "appearance_changed",
   "text": "排水沟的里面积了泥。",
   "factSupported": true,
   "independence": "independent",
   "flags": {
    "language": "“排水沟的里面”"
   }
  },
  {
   "unitId": "t24:f2",
   "sourceId": "t24",
   "kind": "outcome",
   "text": "沈砚把纸灯笼扶正。",
   "factSupported": true,
   "independence": "independent",
   "flags": {}
  },
  {
   "unitId": "t24:f3",
   "sourceId": "t24",
   "kind": "outcome",
   "text": "阿棠把鱼筐放在门槛边。",
   "factSupported": true,
   "independence": "independent",
   "flags": {}
  }
