          "split": "test",
          "inputTokens": 413,
          "targetTokens": 182,
          "targetTruncation": {
            "removedTokens": 54,
            "retainedTail": "不出去,被海风推回来,闷闷地压在耳朵上。 拉完他站着没动,手上还攥着",
