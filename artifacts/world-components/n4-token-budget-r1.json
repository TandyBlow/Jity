            "droppedTail": "正文:"
          },
          "targetTruncation": {
            "removedTokens": 21,
            "retainedTail": "时他还没抬头,阿棠抱着一叠干纸进来,围裙上沾着鱼鳞,纸往桌角一放,鞋",
