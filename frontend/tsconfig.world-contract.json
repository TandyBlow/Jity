{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/lib/world-engine/**/*.ts"]
}
