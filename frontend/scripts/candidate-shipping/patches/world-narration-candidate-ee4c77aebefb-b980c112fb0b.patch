+  return {
+    attempt: 1,
+    prompt: '',
+    promptChars: 0,
+    raw: composed.text,
+    cleaned: composed.text,
+    finishReason: 'stop',
+    error: null,
+    durationMs: elapsedMs,
+    firstTokenMs: null,
+    completion: null,
+    alignment: null,
+    issues,
+    metrics: null,
+    accepted: composed.accepted,
+    cancelled: false,
+    timedOut: false,
+  };
