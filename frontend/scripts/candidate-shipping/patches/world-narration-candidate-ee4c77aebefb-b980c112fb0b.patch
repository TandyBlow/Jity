+  modelEnabled: boolean;
+  modelBudget: () => { enabled: boolean; timeoutMs: number };
+  modelBudgetSpent: () => boolean;
+  prior: string;
+  emit: (progress: CandidateProgress) => void;
+  addVerifyMs: (ms: number) => void;
