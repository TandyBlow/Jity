+export interface CandidateAttempt {
+  attempt: number;
+  prompt: string;
+  promptChars: number;
+  raw: string;
+  cleaned: string;
+  finishReason: string | null;
+  error: string | null;
+  durationMs: number;
+  firstTokenMs: number | null;
+  completion: null;
+  alignment: null;
+  issues: CandidateIssue[];
+  metrics: null;
+  accepted: boolean;
+  cancelled: boolean;
