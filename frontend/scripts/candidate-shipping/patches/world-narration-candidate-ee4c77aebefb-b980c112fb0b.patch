+
+interface WriteBeatArgs {
+  input: GenerateCandidateInput;
+  scene: SceneSkeleton;
+  plan: BeatPlan;
+  ctx: ReturnType<typeof createRealizerContext>;
+  policy: NonNullable<GenerateCandidateInput['policy']>;
+  sanityStyle: 'direction' | 'number';
