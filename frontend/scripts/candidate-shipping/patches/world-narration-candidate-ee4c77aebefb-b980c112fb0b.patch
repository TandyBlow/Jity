+    fromId: previousPosition.containerId,
+    from: locationName(after.state, previousPosition.containerId),
+    toId: delta.positionSet.containerId,
+    to: locationName(after.state, delta.positionSet.containerId),
+    fromVisibility,
+    toVisibility,
+    viewpoint: id === viewpointId,
+  };
+}
+
+function changeFactBase(id: Id, prefix: string): string {
+  return `${prefix}:change:${id}`;
+}
+
+export interface ProjectedScene {
+  scene: SceneSkeleton;
+  base: CommittedNarration;
+}
+
+export function projectConstrainedScene(
+  after: CommittedRead,
+  before: CommittedRead | null,
+  options: ProjectSceneOptions = {},
+): ProjectedScene {
+  validateCommittedRead(after, before);
+  validateDelta(after, before);
+  const state = after.state;
+  const viewpointId = options.viewpointId ?? state.protagonistId;
+  if (!state.characters[viewpointId]) throw new SceneProjectionError('viewpoint_unknown', viewpointId);
+  const prefix = options.idPrefix ?? after.pointId;
+  const roomAfter = roomOf(state, viewpointId);
+  const roomBefore = before ? roomOf(before.state, viewpointId) : roomAfter;
+  const knowledge: SceneKnowledge = { ...emptyKnowledge(), ...(options.knowledge ?? {}) };
+  const facts: SceneFact[] = [];
+  const deltas = after.entityDeltas ?? {};
+
+  // ---- time ----------------------------------------------------------------
+  const advance = after.timeAdvance ?? null;
+  const hasElapsed = advance != null && advance.duration.amount > 0;
+  if (hasElapsed) {
+    facts.push({ id: `${prefix}:time`, kind: 'time', mandatory: true, visibility: 'scene', advance });
+  }
+
+  // ---- moves ---------------------------------------------------------------
+  const moveIds: Id[] = [];
+  for (const id of Object.keys(deltas)) {
+    if (!before) break;
+    const fact = moveFact(after, before, id, deltas[id], roomBefore, roomAfter, prefix, viewpointId);
+    if (fact) {
+      facts.push(fact);
+      moveIds.push(id);
+    }
+  }
+
+  // ---- per-entity changes --------------------------------------------------
+  for (const [id, delta] of Object.entries(deltas)) {
+    const kind = entityKindOf(state, id);
+    if (kind === 'unknown') continue;
+    const name = entityName(state, id);
+    const visibleAfter = kind === 'location' ? id === roomAfter : inView(state, id, roomAfter);
+    const visibility: FactVisibility = visibleAfter ? 'scene' : 'hidden';
+    if (kind !== 'character' && (delta.tasksAchieved?.length || delta.subtasksAdded?.length
+      || delta.personalityChanges?.length || delta.sanitySet != null)) {
+      continue;
+    }
+
+    for (const change of delta.appearanceChanges ?? []) {
+      const records = kind === 'character' ? state.characters[id].appearanceChanges
+        : kind === 'item' ? state.items[id].appearanceChanges : state.locations[id].appearanceChanges;
+      const stored = records.find((record) => record.id === change.id);
+      const supersededTexts = change.supersedes
+        .map((oldId) => records.find((record) => record.id === oldId)?.text ?? (before
+          ? (kind === 'character' ? before.state.characters[id]?.appearanceChanges
+            : kind === 'item' ? before.state.items[id]?.appearanceChanges
+              : before.state.locations[id]?.appearanceChanges)?.find((record) => record.id === oldId)?.text ?? null
+          : null))
+        .filter((text): text is string => Boolean(text));
+      facts.push({
+        id: changeFactBase(change.id, prefix),
+        kind: 'appearance_changed',
+        mandatory: true,
+        visibility,
+        entityId: id,
+        name,
+        entityKind: kind,
+        changeId: change.id,
+        text: change.text ?? null,
+        removed: change.text == null,
+        supersededTexts,
+      });
+      void stored;
+    }
+
+    if (kind !== 'character') continue;
+    const character = state.characters[id];
+
+    for (const taskId of delta.tasksAchieved ?? []) {
+      const task = character.tasks[taskId];
+      if (!task) continue;
+      facts.push({
+        id: `${prefix}:task:${id}:${taskId}`, kind: 'task_achieved', mandatory: true, visibility,
+        ownerId: id, name, taskId, goal: task.goal,
+      });
+    }
+    for (const task of delta.subtasksAdded ?? []) {
+      const parent = task.parentTaskId ? character.tasks[task.parentTaskId] : null;
+      facts.push({
+        id: `${prefix}:subtask:${id}:${task.id}`, kind: 'subtask_added', mandatory: true, visibility,
+        ownerId: id, name, taskId: task.id, parentTaskId: task.parentTaskId,
+        parentGoal: parent?.goal ?? null, goal: task.goal,
+      });
+    }
+    for (const change of delta.personalityChanges ?? []) {
+      const records = character.personalityChanges;
+      const supersededTexts = change.supersedes
+        .map((oldId) => records.find((record) => record.id === oldId)?.text
+          ?? before?.state.characters[id]?.personalityChanges.find((record) => record.id === oldId)?.text ?? null)
+        .filter((text): text is string => Boolean(text));
+      facts.push({
+        id: changeFactBase(change.id, prefix), kind: 'personality_changed', mandatory: true, visibility,
+        ownerId: id, name, changeId: change.id, text: change.text ?? '', removed: change.text == null,
+        supersededTexts,
+      });
+    }
+    if (delta.sanitySet != null && before) {
+      const previous = before.state.characters[id];
+      if (previous && previous.sanity !== delta.sanitySet) {
+        facts.push({
+          id: `${prefix}:sanity:${id}`, kind: 'sanity_changed', mandatory: true, visibility,
+          ownerId: id, name, from: previous.sanity, to: delta.sanitySet,
+        });
+      }
+    }
+  }
+
+  // ---- scene material ------------------------------------------------------
+  const present: ScenePerson[] = sortedIds(state, Object.keys(state.characters)).filter((id) => id !== viewpointId && inView(state, id, roomAfter))
+    .map((id) => ({ id, name: entityName(state, id), note: characterNote(state, id), viewpoint: false }));
+  // Room objects only: items inside a character or a container are licensed
+  // through that entity's note, not as furniture of the room.
+  const objectIds = sortedIds(state, Object.keys(state.items)).filter((id) => positionOf(state, id)?.containerId === roomAfter);
+  const objects: SceneObject[] = objectIds.map((id) => ({ id, name: entityName(state, id), note: itemNote(state, id) }));
+  const objectById = new Map(objects.map((object) => [object.id, object]));
+  const movedSet = new Set(moveIds);
+
+  // Objects whose visibility changed because a container moved are derived
+  // from the saved positions of the two points; they are optional texture.
+  const known = new Set(knowledge.discoveredItemIds);
+  const root = before === null;
+  for (const id of objectIds) {
+    if (movedSet.has(id)) continue;
+    const visibleBefore = before ? before.state.items[id]?.position.containerId === roomBefore : false;
+    if (visibleBefore) continue;
+    const object = objectById.get(id)!;
+    const containerId = positionOf(state, id)?.containerId ?? roomAfter;
+    facts.push({
+      id: `${prefix}:present:${id}`, kind: root || known.has(id) ? 'item_present' : 'item_discovered',
+      mandatory: false, visibility: 'scene', itemId: id, name: object.name,
+      containerId, container: locationName(state, containerId), note: object.note,
+    });
+  }
+  // Present characters are licensed positions (not changes): the prose may say
+  // they are here without claiming they moved.
+  for (const person of present) {
+    // A character who moved this point is licensed by the move fact itself; an
+    // extra at-fact would make the move sentence look like an invented arrival
+    // (the base grader treats at + movement verb as a fabricated move).
+    if (movedSet.has(person.id)) continue;
+    facts.push({
+      id: `${prefix}:at:${person.id}`, kind: 'at', mandatory: false, visibility: 'scene',
+      entityId: person.id, name: person.name, locationId: roomAfter, location: placeNameOf(state, roomAfter),
+    });
+  }
+  if (!movedSet.has(viewpointId)) {
+    facts.push({
+      id: `${prefix}:at:${viewpointId}`, kind: 'at', mandatory: false, visibility: 'scene',
+      entityId: viewpointId, name: entityName(state, viewpointId), locationId: roomAfter, location: locationName(state, roomAfter),
+    });
+  }
+
+  // ---- settled result wording ---------------------------------------------
+  // The settlement's own result line is a fact-bearing description, not a
+  // model free-write: it is licensed verbatim so a question/answer or a
+  // hand-off does not disappear from the prose.
+  if (options.resultsText && options.resultsText.trim()) {
+    facts.push({
+      id: `${prefix}:result`, kind: 'result', mandatory: true, visibility: 'scene',
+      text: clampSentences(options.resultsText, 2, 130),
+    });
+  }
+
+  // ---- licensing -----------------------------------------------------------
+  const names = new Set<string>([entityName(state, viewpointId)]);
+  const locations = new Set<string>([locationName(state, roomAfter)]);
+  const items = new Set<string>();
+  const details = new Set<string>();
+  const quotes = new Set<string>();
+  for (const person of present) { names.add(person.name); if (person.note) details.add(person.note); }
+  for (const object of objects) { items.add(object.name); if (object.note) details.add(object.note); }
+
+  for (const fact of facts) {
+    // Hidden changes are evidence only: they may not license a name, quote or
+    // detail the viewpoint could not perceive.
+    if (fact.visibility !== 'scene') continue;
+    switch (fact.kind) {
+      case 'move':
+        names.add(fact.name);
+        locations.add(fact.from);
+        locations.add(fact.to);
+        if (fact.entityKind === 'item') items.add(fact.name);
+        break;
+      case 'task_achieved':
+        names.add(fact.name);
+        quotes.add(fact.goal);
+        break;
+      case 'subtask_added':
+        names.add(fact.name);
+        quotes.add(fact.goal);
+        if (fact.parentGoal) quotes.add(fact.parentGoal);
+        break;
+      case 'personality_changed':
+        names.add(fact.name);
+        if (fact.text) { details.add(fact.text); quotes.add(fact.text); }
+        for (const text of fact.supersededTexts) details.add(text);
+        break;
+      case 'appearance_changed':
+        names.add(fact.name);
+        if (fact.entityKind === 'item') items.add(fact.name);
+        if (fact.entityKind === 'location') locations.add(fact.name);
+        if (fact.text) details.add(fact.text);
+        for (const text of fact.supersededTexts) details.add(text);
+        break;
+      case 'sanity_changed':
+        names.add(fact.name);
+        break;
+      case 'item_present':
+      case 'item_discovered':
+        items.add(fact.name);
+        if (fact.note) details.add(fact.note);
+        break;
+      case 'at':
+        names.add(fact.name);
+        locations.add(fact.location);
+        break;
+      case 'result':
+        details.add(fact.text);
+        quotes.add(fact.text);
+        break;
+      case 'time':
+        break;
+    }
+  }
+  if (options.resultsText) {
+    for (const word of options.resultsText.split(/[\s，。；：！？、]+/u)) {
+      if (names.has(word) || locations.has(word) || items.has(word)) details.add(word);
+    }
+  }
+
+  const placeName = locationName(state, roomAfter);
+  const placeNote = options.scene?.placeNote ?? locationNote(state, roomAfter);
+  // The settled room description is licensed material: it may name a
+  // neighbouring place ("走廊通往门厅") without that being an invented move.
+  if (placeNote) details.add(placeNote);
+  const presentWithHints: ScenePerson[] = present.map((person) => ({
+    ...person,
+    note: options.scene?.presentNotes?.[person.id] ?? person.note,
+  }));
+  const objectsWithHints: SceneObject[] = objects.map((object) => ({
+    ...object,
+    note: options.scene?.objectNotes?.[object.id] ?? object.note,
+  }));
+  const parentId = state.initial.locations[roomAfter]?.parentLocationId ?? null;
+
+  const scene: SceneSkeleton = {
+    anchor: {
+      worldId: state.worldId, pointId: after.pointId, version: after.version,
+      stateDigest: after.stateDigest, previousPointId: after.previousPointId,
+    },
+    viewpoint: {
+      id: viewpointId, name: entityName(state, viewpointId), locationId: roomAfter, location: placeName,
+      note: characterNote(state, viewpointId),
+      personality: joinNote(state.initial.characters[viewpointId]?.initialPersonality ?? '',
+        state.characters[viewpointId]?.personalityChanges ?? [], 80),
+      sanity: state.characters[viewpointId].sanity,
+    },
+    time: advance,
+    place: { id: roomAfter, name: placeName, note: placeNote, parentName: parentId ? locationName(state, parentId) : null },
+    present: presentWithHints,
+    objects: objectsWithHints,
+    facts,
+    worldNames: {
+      characters: Object.values(state.initial.characters).map((entity) => entity.name),
+      locations: Object.values(state.initial.locations).map((entity) => entity.name),
+      items: Object.values(state.initial.items).map((entity) => entity.name),
+    },
+    licensed: {
+      names: [...names].sort((a, b) => a.localeCompare(b, 'zh')),
+      locations: [...locations].sort((a, b) => a.localeCompare(b, 'zh')),
+      items: [...items].sort((a, b) => a.localeCompare(b, 'zh')),
+      details: [...expandedDetails(details)],
+      quotes: [...quotes],
+    },
+    knowledge,
+    priorText: options.priorText ?? null,
+    inputText: options.inputText ?? null,
+    resultsText: options.resultsText ?? null,
+    hasSceneMaterial: true,
+    timeOnly: !Object.keys(deltas).length,
+  };
+
+  return { scene, base: buildBasePacket(scene) };
+}
+
+/** Notes are emitted clause by clause, so a cut prefix must stay licensed:
+ * add every comma/period segment of a settled description next to the whole. */
+function expandedDetails(details: Set<string>): Set<string> {
+  const out = new Set<string>();
+  for (const detail of details) {
+    out.add(detail);
+    for (const part of detail.split(new RegExp('[，。；：、\n]+', 'u'))) {
+      if ([...part.trim()].length >= 2) out.add(part.trim());
+    }
+  }
+  return out;
+}
+
+function clampSentences(text: string, maxSentences: number, maxChars: number): string {
+  const clean = text.replace(/\s+/gu, ' ').trim();
+  const parts = clean.split(/(?<=[。！？])/u).map((part) => part.trim()).filter(Boolean);
+  let out = (parts.length ? parts : [clean]).slice(0, maxSentences).join('');
+  if ([...out].length > maxChars) {
+    const cut = [...out].slice(0, maxChars).join('');
+    out = `${cut.replace(/[，、；：]$/u, '')}。`;
+  }
+  return out;
+}
+
+/** Facts the legacy alignment gate can grade without new vocabulary. Sanity is
+ * deliberately absent: this route expresses the committed DIRECTION, not the
+ * raw number (`policy.sanityStyle: 'number'` restores the numeric statement). */
+function buildBasePacket(scene: SceneSkeleton): CommittedNarration {
+  const facts: NarrationFact[] = [];
+  // The legacy grader splits sentences on terminal punctuation, so frozen text
+  // ending with 。 would never bind. Normalise the packet copy only.
+  const frozen = (text: string): string => text.replace(/[。！？\s]+$/u, '');
+  for (const fact of scene.facts) {
+    if (fact.visibility !== 'scene') continue;
+    if (fact.kind === 'move') {
+      facts.push({
+        id: fact.id, actorId: fact.entityId, name: fact.name, kind: 'moved',
+        fromId: fact.fromId, from: fact.from, toId: fact.toId, to: fact.to,
+      });
+    } else if (fact.kind === 'task_achieved') {
+      facts.push({ id: fact.id, actorId: fact.ownerId, name: fact.name, kind: 'task_achieved', taskId: fact.taskId, goal: frozen(fact.goal) });
+    } else if (fact.kind === 'personality_changed') {
+      facts.push({ id: fact.id, actorId: fact.ownerId, name: fact.name, kind: 'personality_changed', changeId: fact.changeId, text: frozen(fact.text) });
+    } else if (fact.kind === 'at') {
+      // Only the viewpoint's own position fact goes into the legacy packet.
+      // Present bystanders are licensed through knownPositions instead; an
+      // at-fact per bystander would make every presence sentence look like it
+      // re-attributed somebody else's position (actor_swap).
+      if (fact.entityId !== scene.viewpoint.id) continue;
+      facts.push({ id: fact.id, actorId: fact.entityId, name: fact.name, kind: 'at', locationId: fact.locationId, location: fact.location });
+    }
+  }
+  return { anchor: scene.anchor, facts };
+}
+
+/** Facts-only skeleton: used when the caller only has a `CommittedNarration`
+ * packet (no full state). It still plans and writes prose, but has no place
+ * notes or object material. */
+export function projectFromFactsPacket(
+  packet: CommittedNarration,
+  options: ProjectSceneOptions = {},
+): ProjectedScene {
+  // The viewpoint is either standing (at) or arriving (moved) this point; a
+  // facts-only packet with a pure move still knows who moved and where to.
+  const atFact = packet.facts.find((fact) => fact.kind === 'at');
+  const movedFact = packet.facts.find((fact) => fact.kind === 'moved');
+  const anchorFact = atFact ?? movedFact;
+  const viewpointName = anchorFact?.name ?? '主角';
+  const location = atFact?.kind === 'at' ? atFact.location : movedFact?.kind === 'moved' ? movedFact.to : '';
+  if (!location) throw new SceneProjectionError('facts_packet_without_scene', 'needs an at-fact or a moved-fact for the viewpoint');
+  const facts: SceneFact[] = [];
+  const advance = options.timeAdvance ?? null;
+  if (advance && advance.duration.amount > 0) {
+    facts.push({ id: `${options.idPrefix ?? 'facts'}:time`, kind: 'time', mandatory: true, visibility: 'scene', advance });
+  }
+  // The caller's settled answer (a question answered, a hand-off) must stay in
+  // the prose; it is quoted, not paraphrased.
+  if (options.resultsText && options.resultsText.trim()) {
+    facts.push({
+      id: `${options.idPrefix ?? 'facts'}:result`, kind: 'result', mandatory: true, visibility: 'scene',
+      text: clampSentences(options.resultsText, 2, 130),
+    });
+  }
+  // The viewpoint's own position is a licensed fact, not a change: without it
+  // the opening cannot say where the player is.
+  if (anchorFact?.kind === 'at') {
+    facts.push({
+      id: `${options.idPrefix ?? 'facts'}:at:viewpoint`, kind: 'at', mandatory: false, visibility: 'scene',
+      entityId: anchorFact.actorId, name: anchorFact.name, locationId: anchorFact.locationId, location: anchorFact.location,
+    });
+  }
+  for (const fact of packet.facts) {
+    if (fact.kind === 'at' && fact.name === viewpointName) continue;
+    if (fact.kind === 'at') {
+      facts.push({ id: fact.id, kind: 'at', mandatory: false, visibility: 'scene', entityId: fact.actorId, name: fact.name, locationId: fact.locationId, location: fact.location });
+    } else if (fact.kind === 'moved') {
+      facts.push({
+        id: fact.id, kind: 'move', mandatory: true, visibility: 'scene', entityId: fact.actorId, name: fact.name,
+        entityKind: 'character', fromId: fact.fromId, from: fact.from, toId: fact.toId, to: fact.to,
+        fromVisibility: 'in_view', toVisibility: 'in_view', viewpoint: fact.name === viewpointName,
+      });
+    } else if (fact.kind === 'task_achieved') {
+      facts.push({ id: fact.id, kind: 'task_achieved', mandatory: true, visibility: 'scene', ownerId: fact.actorId, name: fact.name, taskId: fact.taskId, goal: fact.goal });
+    } else if (fact.kind === 'personality_changed') {
+      facts.push({ id: fact.id, kind: 'personality_changed', mandatory: true, visibility: 'scene', ownerId: fact.actorId, name: fact.name, changeId: fact.changeId, text: fact.text, removed: false, supersededTexts: [] });
+    } else if (fact.kind === 'sanity_changed') {
+      facts.push({ id: fact.id, kind: 'sanity_changed', mandatory: true, visibility: 'scene', ownerId: fact.actorId, name: fact.name, from: fact.from, to: fact.to });
+    } else if (fact.kind === 'sanity') {
+      // unchanged value: not a fact to narrate
+    }
+  }
+  // Present characters come from the packet's own at-facts (the shared driver
+  // emits one per character in the room). They are licensed presence, not a
+  // change.
+  const hints = options.scene ?? null;
+  const present: ScenePerson[] = [];
+  for (const fact of packet.facts) {
+    if (fact.kind !== 'at' || fact.name === viewpointName) continue;
+    if (present.some((person) => person.id === fact.actorId)) continue;
+    present.push({
+      id: fact.actorId, name: fact.name,
+      note: hints?.presentNotes?.[fact.name] ?? '', viewpoint: false,
+    });
+  }
+  // The caller's already-settled scene hints carry room objects the fact packet
+  // does not list. They are descriptions, not new facts.
+  const objects: SceneObject[] = Object.entries(hints?.objectNotes ?? {})
+    .filter(([name, note]) => Boolean(name && note))
+    .map(([name, note]) => ({ id: `object:${name}`, name, note }));
+  const rawPlaceNote = hints?.placeNote ?? '';
+  const prefix = `${location}：`;
+  const placeNote = rawPlaceNote.startsWith(prefix) ? rawPlaceNote.slice(prefix.length) : rawPlaceNote;
+  const scene: SceneSkeleton = {
+    anchor: packet.anchor,
+    viewpoint: {
+      id: anchorFact?.kind === 'at' ? anchorFact.actorId : 'viewpoint',
+      name: viewpointName, locationId: anchorFact?.kind === 'at' ? anchorFact.locationId : '', location,
+      note: '', personality: '', sanity: 0,
+    },
+    time: advance,
+    place: { id: '', name: location, note: placeNote, parentName: null },
+    present,
+    objects,
+    facts,
+    licensed: {
+      names: [...new Set([...packet.facts.map((fact) => fact.name), ...present.map((person) => person.name)])],
+      locations: [...new Set(packet.facts.flatMap((fact) => fact.kind === 'moved' ? [fact.from, fact.to] : fact.kind === 'at' ? [fact.location] : []))],
+      items: objects.map((object) => object.name),
+      details: [...expandedDetails(new Set([
+        placeNote,
+        ...present.map((person) => person.note),
+        ...objects.map((object) => object.note),
+      ].filter(Boolean)))],
+      quotes: [...new Set([
+        ...packet.facts.flatMap((fact) => fact.kind === 'task_achieved' ? [fact.goal] : []),
+        ...(options.resultsText ? [clampSentences(options.resultsText, 2, 130)] : []),
+      ])],
+    },
+    knowledge: { ...emptyKnowledge(), ...(options.knowledge ?? {}) },
+    priorText: options.priorText ?? null,
+    inputText: options.inputText ?? null,
+    resultsText: options.resultsText ?? null,
+    worldNames: { characters: [], locations: [], items: [] },
+    hasSceneMaterial: present.length > 0 || objects.length > 0,
+    timeOnly: !facts.some((fact) => fact.kind !== 'time' && fact.kind !== 'at'),
+  };
+  return { scene, base: packet };
+}
+
+export type { Change, Task, TimeAdvance };

diff --git a/frontend/src/lib/world-engine/local/narration-candidates/constrained/realize.ts b/frontend/src/lib/world-engine/local/narration-candidates/constrained/realize.ts
new file mode 100644
--- /dev/null
+++ b/frontend/src/lib/world-engine/local/narration-candidates/constrained/realize.ts
@@ -0,0 +1,457 @@
+/** Program realizer: settled fact -> readable prose.
+ *
+ * Every sentence here is built from a fact payload or from a description that
+ * already exists in the settled state. The realizer adds only micro-actions
+ * (a pause, a breath, a glance) and never a new person, prop, weather, past
+ * event, clue or promise. Variants are drawn deterministically from the beat
+ * seed, and repeated sentences/openings are avoided within a text and against
+ * the previous accepted turn.
+ */
+import type { TimeAdvance } from '../../../types';
+import { cnNumber } from '../../../runtime/narration-alignment';
+import type { BeatDirective, SceneFact, SceneSkeleton } from './types';
+
+const PARA_BREAK = String.fromCharCode(10, 10);
+
+const UNIT_LABEL: Record<TimeAdvance['duration']['unit'], string> = {
+  second: '秒', minute: '分钟', hour: '小时', day: '天', month: '个月', year: '年',
+};
+
+export function durationLabel(advance: TimeAdvance): string {
+  const amount = advance.duration.amount;
+  const read = amount === 2 ? '两' : amount === 1 ? '一' : cnNumber(amount) ?? String(amount);
+  const unit = UNIT_LABEL[advance.duration.unit];
+  if (advance.duration.unit === 'hour' || advance.duration.unit === 'month') {
+    return `${read}个${advance.duration.unit === 'hour' ? '小时' : '月'}`;
+  }
+  return `${read}${unit}`;
+}
+
+export const SANITY_DOWN_CUES = ['沉', '紧', '往下', '发凉', '收紧', '坠', '缩'];
+export const SANITY_UP_CUES = ['松', '顺', '稳', '回暖', '舒', '缓', '放平'];
+
+export function sanityDirection(from: number, to: number): 'down' | 'up' | 'flat' {
+  if (to < from) return 'down';
+  if (to > from) return 'up';
+  return 'flat';
+}
+
+function pick(seed: number, salt: string, size: number): number {
+  if (size <= 1) return 0;
+  let value = seed >>> 0;
+  for (let index = 0; index < salt.length; index += 1) {
+    value ^= salt.charCodeAt(index);
+    value = Math.imul(value, 16777619) >>> 0;
+  }
+  return value % size;
+}
+
+function stripEnd(text: string): string {
+  return text.replace(/[。！？!?；;，,、\s]+$/u, '').trim();
+}
+
+function asSentence(text: string): string {
+  const clean = stripEnd(text);
+  return clean ? `${clean}。` : '';
+}
+
+function bigrams(text: string): Set<string> {
+  const stripped = text.replace(/[\s，。！？；：、「」“”"'（）()]/gu, '');
+  const out = new Set<string>();
+  for (let index = 0; index + 1 < stripped.length; index += 1) out.add(stripped.slice(index, index + 2));
+  return out;
+}
+
+function overlaps(left: string, right: string): number {
+  const a = bigrams(left);
+  const b = bigrams(right);
+  if (!a.size || !b.size) return 0;
+  let shared = 0;
+  for (const gram of a) if (b.has(gram)) shared += 1;
+  return shared / Math.max(a.size, b.size);
+}
+
+/** Description clause safe to use as a scene detail. */
+function clause(text: string, max = 30): string {
+  const clean = text.replace(/\s+/gu, ' ').trim();
+  if (!clean) return '';
+  const parts = clean.split(/[。；;!?！？]/u).map((part) => part.trim()).filter(Boolean);
+  let picked = parts[0] ?? clean;
+  const commaParts = picked.split(/[，,]/u);
+  if (picked.length > max && commaParts.length > 1) {
+    picked = commaParts[0];
+    for (let index = 1; index < commaParts.length; index += 1) {
+      const next = `${picked}，${commaParts[index]}`;
+      if (next.length > max) break;
+      picked = next;
+    }
+  }
+  return stripEnd(picked);
+}
+
+/** A complete settled sentence, shortened only at a comma and marked with an
+ * ellipsis when it does not fit. Cutting a rule list at a semicolon would read
+ * as if the rest of the rule did not exist. */
+function sentenceClause(text: string, max = 64): string {
+  const clean = text.replace(/\s+/gu, ' ').trim();
+  if (!clean) return '';
+  const end = clean.search(/[。！？!?]/u);
+  const sentence = end >= 0 ? clean.slice(0, end) : clean;
+  if ([...sentence].length <= max) return stripEnd(sentence);
+  const cut = [...sentence].slice(0, max).join('');
+  const comma = Math.max(cut.lastIndexOf('，'), cut.lastIndexOf('、'), cut.lastIndexOf('；'));
+  const kept = (comma > max * 0.4 ? cut.slice(0, comma) : cut).replace(/[，、；]+$/u, '');
+  return `${kept}……`;
+}
+
+export interface RealizerContext {
+  scene: SceneSkeleton;
+  priorText: string | null;
+  /** Sentences already used in this text (dedupe). */
+  used: Set<string>;
+  /** Prefer the numeric sanity statement (legacy alignment gate). */
+  sanityStyle: 'direction' | 'number';
+  /** Openings used by previous accepted turns; avoid repeating them. */
+  avoidOpenings: string[];
+}
+
+export function createRealizerContext(
+  scene: SceneSkeleton,
+  priorText: string | null,
+  sanityStyle: 'direction' | 'number',
+): RealizerContext {
+  return { scene, priorText, used: new Set(), sanityStyle, avoidOpenings: [] };
+}
+
+/** Register already-final text (a retry or another writer's accepted beat) so
+ * later beats do not repeat it and position claims stay consistent. */
+const SENTENCE_ENDS = new RegExp('[' + [0x3002, 0xff01, 0xff1f, 0x0a].map((code) => String.fromCharCode(code)).join('') + ']+', 'u');
+
+export function absorbText(ctx: RealizerContext, text: string): void {
+  for (const part of text.split(SENTENCE_ENDS)) {
+    const core = stripEnd(part);
+    if (core) ctx.used.add(core);
+  }
+}
+
+export function realizeBeat(beat: BeatDirective, ctx: RealizerContext): string {
+  const facts = beat.factIds
+    .map((id) => ctx.scene.facts.find((fact) => fact.id === id))
+    .filter((fact): fact is SceneFact => Boolean(fact));
+  if (beat.kind === 'open') return openBeat(beat, ctx);
+  if (beat.kind === 'move') return moveBeat(beat, facts, ctx);
+  if (beat.kind === 'event') return eventBeat(beat, facts, ctx);
+  if (beat.kind === 'result') return resultBeat(facts, ctx);
+  if (beat.kind === 'scene') return sceneBeat(beat, facts, ctx);
+  return closeBeat(beat, ctx);
+}
+
+function remember(ctx: RealizerContext, sentence: string): string {
+  if (!sentence) return '';
+  ctx.used.add(stripEnd(sentence));
+  return sentence;
+}
+
+function acceptable(ctx: RealizerContext, sentence: string): boolean {
+  const core = stripEnd(sentence);
+  if (ctx.used.has(core)) return false;
+  // A sentence the player read last turn may not come back verbatim; the
+  // bigram check alone is weak against a long previous text.
+  if (core && ctx.priorText?.includes(core)) return false;
+  if (ctx.avoidOpenings.some((opening) => opening && stripEnd(sentence).startsWith(stripEnd(opening)))) return false;
+  if (ctx.priorText && overlaps(sentence, ctx.priorText) > 0.55) return false;
+  return true;
+}
+
+function choose(ctx: RealizerContext, seed: number, salt: string, variants: string[]): string {
+  const clean = variants.map((variant) => stripEnd(variant)).filter(Boolean);
+  if (!clean.length) return '';
+  const start = pick(seed, salt, clean.length);
+  for (let offset = 0; offset < clean.length; offset += 1) {
+    const candidate = clean[(start + offset) % clean.length];
+    if (acceptable(ctx, candidate)) return `${candidate}。`;
+  }
+  // Every variant collides with the previous turn (a repeated one-minute
+  // point, for instance). Prefer the least similar one instead of repeating
+  // the same sentence verbatim.
+  let best = clean[start];
+  let bestScore = Number.POSITIVE_INFINITY;
+  for (const candidate of clean) {
+    if (ctx.used.has(candidate)) continue;
+    if (ctx.priorText?.includes(candidate)) continue;
+    const score = ctx.priorText ? overlaps(candidate, ctx.priorText) : 0;
+    if (score < bestScore) { best = candidate; bestScore = score; }
+  }
+  return `${best}。`;
+}
+
+function openBeat(beat: BeatDirective, ctx: RealizerContext): string {
+  const { scene } = ctx;
+  const paragraphs: string[] = [];
+  const time = scene.facts.find((fact) => beat.factIds.includes(fact.id) && fact.kind === 'time');
+  if (time && time.kind === 'time') {
+    const label = durationLabel(time.advance);
+    paragraphs.push(remember(ctx, choose(ctx, beat.seed, 'time', [
+      `${label}过去了`,
+      `过了${label}`,
+      `${label}之后`,
+      `又过了${label}`,
+      `整整${label}过去`,
+    ])));
+  }
+  const detailText = sentenceClause(scene.place.note, 48);
+  // A settled room description is reused only on the turn it becomes visible;
+  // repeating it verbatim every round is the "same paragraph again" failure.
+  const detail = detailText && ctx.priorText?.includes(detailText) ? '' : detailText;
+  const place = scene.place.name || scene.viewpoint.location;
+  const viewpoint = scene.viewpoint.name;
+  const viewpointMoved = scene.facts.some((fact) => fact.kind === 'move' && fact.viewpoint);
+  const variants: string[] = [];
+  // The room is described after the arrival, in the move beat, when the
+  // viewpoint moves this point; describing it first would spoil the move.
+  if (detail && !viewpointMoved) {
+    if (detail.includes(place)) variants.push(detail);
+    else {
+      variants.push(`${place}里，${detail}`);
+      variants.push(`${place}里，${detail.replace(/[。！？]+$/u, '')}`);
+    }
+  }
+  // Only assert a standing position when the point itself says the viewpoint
+  // is here AND the room has no settled description to open with (a move beat
+  // follows otherwise and would be told backwards).
+  if (!variants.length && scene.facts.some((fact) => fact.kind === 'at' && fact.entityId === scene.viewpoint.id)) {
+    variants.push(`${viewpoint}还在${place}`);
+    variants.push(`${viewpoint}站在${place}`);
+  }
+  const opening = remember(ctx, choose(ctx, beat.seed, 'place', variants.filter(Boolean)));
+  if (opening) paragraphs.push(opening);
+  return paragraphs.filter(Boolean).join('\n\n');
+}
+
+type MoveFact = Extract<SceneFact, { kind: 'move' }>;
+
+// Only verbs the legacy grader recognises as movement; anything else reads as
+// an unbacked arrival.
+const ARRIVAL_VERBS = ['走进', '走到', '来到', '进入'];
+
+function moveVerb(fact: MoveFact, seed: number, salt: string): string {
+  if (fact.entityKind === 'item') return '移到';
+  return ARRIVAL_VERBS[pick(seed, salt, ARRIVAL_VERBS.length)];
+}
+
+function moveSentence(fact: MoveFact, seed: number, salt: string, ctx: RealizerContext): string {
+  const verb = moveVerb(fact, seed, salt);
+  if (fact.entityKind === 'item') {
+    // An item leaving somebody's hands reads better than "从路明非移到".
+    if (ctx.scene.present.some((person) => person.id === fact.fromId) || fact.fromId === ctx.scene.viewpoint.id) {
+      return choose(ctx, seed, `${salt}:item`, [
+        `${fact.name}从${fact.from}身上${verb}${fact.to}`,
+        `${fact.name}离开${fact.from}的手边，${verb}${fact.to}`,
+      ]);
+    }
+    return choose(ctx, seed, `${salt}:item`, [
+      `${fact.name}从${fact.from}${verb}${fact.to}`,
+      `${fact.name}被从${fact.from}${verb}${fact.to}`,
+    ]);
+  }
+  const variants = [
+    `${fact.name}从${fact.from}${verb}${fact.to}`,
+    `${fact.name}离开${fact.from}，${verb}${fact.to}`,
+    `${fact.name}没有停，从${fact.from}${verb}${fact.to}`,
+  ];
+  return choose(ctx, seed, `${salt}:move`, variants);
+}
+
+function moveBeat(beat: BeatDirective, facts: SceneFact[], ctx: RealizerContext): string {
+  const paragraphs: string[] = [];
+  const moves = facts.filter((fact): fact is MoveFact => fact.kind === 'move');
+  for (const [index, fact] of moves.entries()) {
+    paragraphs.push(remember(ctx, moveSentence(fact, beat.seed, `${beat.id}:${index}`, ctx)));
+  }
+  if (moves.some((fact) => fact.viewpoint) && ctx.scene.place.note) {
+    const detail = sentenceClause(ctx.scene.place.note, 48);
+    const alreadySaid = [...ctx.used].some((used) => used.includes(stripEnd(detail)));
+    // Keep the room's name on the detail so it cannot read as a stray sign.
+    const placeName = ctx.scene.place.name || ctx.scene.viewpoint.location;
+    const framed = detail
+      ? asSentence(detail.includes(placeName) ? detail : `${placeName}里，${detail}`)
+      : '';
+    if (framed && !alreadySaid && acceptable(ctx, framed)) paragraphs.push(remember(ctx, framed));
+  }
+  return paragraphs.filter(Boolean).join('\n\n');
+}
+
+function eventBeat(beat: BeatDirective, facts: SceneFact[], ctx: RealizerContext): string {
+  const paragraphs: string[] = [];
+  const push = (text: string) => {
+    const sentence = asSentence(text);
+    if (!sentence || ctx.used.has(stripEnd(sentence))) return;
+    paragraphs.push(remember(ctx, sentence));
+  };
+  // Appearance first: the visible result before the inner consequence.
+  for (const fact of facts) {
+    if (fact.kind === 'appearance_changed') {
+      const name = fact.name;
+      if (fact.removed) {
+        const old = fact.supersededTexts[0] ? clause(fact.supersededTexts[0], 18) : '';
+        push(old
+          ? choose(ctx, beat.seed, `${fact.id}:rm`, [`${name}不再像先前那样${old}`, `${name}身上，${old}的样子没有了`])
+          : choose(ctx, beat.seed, `${fact.id}:rm2`, [`${name}身上先前那点变化淡了`]));
+      } else if (fact.text) {
+        const text = stripEnd(fact.text);
+        if (fact.entityKind === 'location') {
+          push(choose(ctx, beat.seed, `${fact.id}:loc`, [text]));
+        } else {
+          push(choose(ctx, beat.seed, `${fact.id}`, [
+            `${name}身上，${text}`,
+            `${name}看上去和先前不同：${text}`,
+          ]));
+        }
+      }
+    }
+  }
+  for (const fact of facts) {
+    if (fact.kind === 'task_achieved') {
+      push(choose(ctx, beat.seed, `${fact.id}`, [
+        `「${fact.goal}」这件事，到这里有了结果`,
+        `${fact.name}完成了「${fact.goal}」`,
+        `${fact.name}把「${fact.goal}」这件事做完了`,
+      ]));
+    }
+    if (fact.kind === 'subtask_added') {
+      push(choose(ctx, beat.seed, `${fact.id}`, [
+        `${fact.name}给自己记下一条：${fact.goal}`,
+        `${fact.name}还有下一件事要做：${fact.goal}`,
+      ]));
+    }
+  }
+  for (const fact of facts) {
+    if (fact.kind === 'personality_changed') {
+      if (fact.removed) {
+        const old = fact.supersededTexts[0] ? clause(fact.supersededTexts[0], 16) : '';
+        push(old
+          ? choose(ctx, beat.seed, `${fact.id}:rm`, [`${fact.name}收起了「${old}」这一面`, `${fact.name}不再像先前那样${old}`])
+          : choose(ctx, beat.seed, `${fact.id}:rm2`, [`${fact.name}的性子又变了一点`]));
+      } else if (fact.text) {
+        // Name first and no comma before the frozen text: the legacy grader
+        // binds a personality change within the name clause plus two clauses,
+        // so the full text has to start in the name clause.
+        push(choose(ctx, beat.seed, `${fact.id}`, [
+          `${fact.name}的性子变了一点：${fact.text}`,
+          `${fact.name}身上多了一点变化：${fact.text}`,
+        ]));
+      }
+    }
+  }
+  for (const fact of facts) {
+    if (fact.kind === 'sanity_changed') {
+      if (ctx.sanityStyle === 'number') {
+        const from = cnNumber(fact.from) ?? String(fact.from);
+        const to = cnNumber(fact.to) ?? String(fact.to);
+        const verb = fact.to < fact.from ? '落到' : '回到';
+        push(choose(ctx, beat.seed, `${fact.id}:n`, [
+          `${fact.name}的精神值从${from}${verb}${to}`,
+          `${fact.name}的数值从${from}${verb}${to}`,
+        ]));
+      } else {
+        const direction = sanityDirection(fact.from, fact.to);
+        push(choose(ctx, beat.seed, `${fact.id}:d`, direction === 'down' ? [
+          `${fact.name}的呼吸沉了一格`,
+          `${fact.name}喉咙紧了一下`,
+          `${fact.name}的肩膀往下收了收`,
+        ] : direction === 'up' ? [
+          `${fact.name}的呼吸顺了回来`,
+          `${fact.name}胸口松了一点`,
+          `${fact.name}的肩膀松下来`,
+        ] : [`${fact.name}的神色没有变`]));
+      }
+    }
+  }
+  return paragraphs.filter(Boolean).join('\n\n');
+}
+
+function resultBeat(facts: SceneFact[], ctx: RealizerContext): string {
+  const result = facts.find((fact) => fact.kind === 'result');
+  if (!result || result.kind !== 'result') return '';
+  const text = result.text.trim();
+  if (!text || ctx.used.has(stripEnd(text))) return '';
+  return remember(ctx, text.endsWith('。') || text.endsWith('！') || text.endsWith('？') ? text : asSentence(text));
+}
+
+function sceneBeat(beat: BeatDirective, facts: SceneFact[], ctx: RealizerContext): string {
+  const { scene } = ctx;
+  const place = scene.place.name || scene.viewpoint.location;
+  const paragraphs: string[] = [];
+  const alreadySaid = (name: string, note = ''): boolean => [...ctx.used].some((used) => used.includes(name))
+    || Boolean(note && ctx.priorText?.includes(sentenceClause(note, 56)));
+  // A present character gives the room a witness instead of a list of props.
+  const person = beat.subject === null
+    ? scene.present.find((entry) => !beat.mustMention.includes(entry.name) && !alreadySaid(entry.name, entry.note))
+    : undefined;
+  if (person) {
+    const detail = clause(person.note, 22);
+    paragraphs.push(remember(ctx, choose(ctx, beat.seed, `${person.id}:at`, detail ? [
+      `${person.name}也在${place}，${detail}`,
+      `${place}里还有${person.name}，${detail}`,
+    ] : [
+      `${person.name}也在${place}`,
+      `${place}里还有${person.name}`,
+    ])));
+  }
+  for (const fact of facts) {
+    if (fact.kind === 'item_present') {
+      const detail = ctx.priorText?.includes(sentenceClause(fact.note, 56)) ? '' : sentenceClause(fact.note, 56);
+      paragraphs.push(remember(ctx, choose(ctx, beat.seed, `${fact.id}`, detail ? [
+        `${fact.name}还在原处。${detail}`,
+        `${fact.name}没有挪动，${detail}`,
+      ] : [
+        `${fact.name}还在原处`,
+        `${fact.name}仍在${fact.container}`,
+      ])));
+    } else if (fact.kind === 'item_discovered') {
+      const detail = ctx.priorText?.includes(sentenceClause(fact.note, 56)) ? '' : sentenceClause(fact.note, 56);
+      paragraphs.push(remember(ctx, choose(ctx, beat.seed, `${fact.id}`, detail ? [
+        `${fact.name}就在${fact.container}。${detail}`,
+        `${fact.container}里，${fact.name}还在原处；${detail}`,
+      ] : [
+        `${fact.name}就在${fact.container}`,
+        `${fact.name}在${fact.container}，先前没有留意`,
+      ])));
+    }
+  }
+  // No item change this point: existing room objects carry the scene instead.
+  if (!facts.length) {
+    for (const object of scene.objects.filter((entry) => entry.note && !alreadySaid(entry.name, entry.note)).slice(0, 2)) {
+      const detail = sentenceClause(object.note, 56);
+      if (!detail) continue;
+      paragraphs.push(remember(ctx, choose(ctx, beat.seed, `${object.id}:note`, [
+        `${object.name}在${place}，${detail}`,
+        `${place}里，${object.name}还在原处；${detail}`,
+      ])));
+    }
+  }
+  return paragraphs.filter(Boolean).join(PARA_BREAK);
+}
+
+function closeBeat(beat: BeatDirective, ctx: RealizerContext): string {
+  const { scene } = ctx;
+  const name = scene.viewpoint.name;
+  const person = scene.present[0]?.name;
+  const place = scene.place.name || scene.viewpoint.location;
+  const alreadyHere = [...ctx.used].some((used) => used.includes(name) && (used.includes('在') || used.includes('留')));
+  const variants = [
+    `${name}没有马上再动`,
+    `${name}把视线收回来`,
+    `${name}待了一会儿`,
+    `${name}没有再往前`,
+    `${name}没有作声`,
+  ];
+  if (person) {
+    variants.push(`${person}也没有动`);
+    variants.push(`${person}那边没有动静`);
+  }
+  if (scene.timeOnly && !alreadyHere) {
+    variants.push(`${name}留在${place}`);
+  }
+  return remember(ctx, choose(ctx, beat.seed, 'close', variants));
+}

diff --git a/frontend/src/lib/world-engine/local/narration-candidates/constrained/types.ts b/frontend/src/lib/world-engine/local/narration-candidates/constrained/types.ts
new file mode 100644
--- /dev/null
+++ b/frontend/src/lib/world-engine/local/narration-candidates/constrained/types.ts
@@ -0,0 +1,353 @@
+/** C route: constrained narration candidate.
+ *
+ * The program reads the committed point (state + Δ), builds a read-only scene
+ * skeleton and a beat plan (subject / direction / result / scene detail), then
+ * asks a prose composer to write each beat. The composer may be a program
+ * realizer, lane 07's composer, or a constrained small model. Every beat is
+ * verified against the facts it was given; a failed beat is replaced by the
+ * program realization of the SAME beat (never by a fact list), then the whole
+ * text is verified again.
+ *
+ * This module never writes world state and never re-derives facts from prose.
+ */
+import type {
+  EntityDelta, Id, Json, TimeAdvance, WorldState,
+} from '../../../types';
+import type { InferenceEngine } from '../../../runtime/engine';
+import type { CommittedNarration, NarrationFact } from '../../../runtime/committed-narration';
+
+/** One settled fact the narration may state. `mandatory` facts must appear in
+ * the accepted text; optional facts are licensed scene material. */
+export type SceneFact =
+  | { id: string; kind: 'time'; mandatory: boolean; visibility: FactVisibility; advance: TimeAdvance }
+  | {
+    id: string; kind: 'move'; mandatory: boolean; visibility: FactVisibility;
+    entityId: Id; name: string; entityKind: 'character' | 'item';
+    fromId: Id; from: string; toId: Id; to: string;
+    /** Relation to the viewpoint's location at the START and END of the point. */
+    fromVisibility: 'in_view' | 'out_of_view'; toVisibility: 'in_view' | 'out_of_view';
+    viewpoint: boolean;
+  }
+  | {
+    id: string; kind: 'task_achieved'; mandatory: boolean; visibility: FactVisibility;
+    ownerId: Id; name: string; taskId: Id; goal: string;
+  }
+  | {
+    id: string; kind: 'subtask_added'; mandatory: boolean; visibility: FactVisibility;
+    ownerId: Id; name: string; taskId: Id; parentTaskId: Id | null; parentGoal: string | null; goal: string;
+  }
+  | {
+    id: string; kind: 'personality_changed'; mandatory: boolean; visibility: FactVisibility;
+    ownerId: Id; name: string; changeId: Id; text: string; removed: boolean; supersededTexts: string[];
+  }
+  | {
+    id: string; kind: 'sanity_changed'; mandatory: boolean; visibility: FactVisibility;
+    ownerId: Id; name: string; from: number; to: number;
+  }
+  | {
+    id: string; kind: 'appearance_changed'; mandatory: boolean; visibility: FactVisibility;
+    entityId: Id; name: string; entityKind: 'character' | 'item' | 'location';
+    changeId: Id; text: string | null; removed: boolean; supersededTexts: string[];
+  }
+  | {
+    id: string; kind: 'at'; mandatory: boolean; visibility: FactVisibility;
+    entityId: Id; name: string; locationId: Id; location: string;
+  }
+  | {
+    id: string; kind: 'item_present'; mandatory: boolean; visibility: FactVisibility;
+    itemId: Id; name: string; containerId: Id; container: string; note: string;
+  }
+  | {
+    id: string; kind: 'item_discovered'; mandatory: boolean; visibility: FactVisibility;
+    itemId: Id; name: string; containerId: Id; container: string; note: string;
+  }
+  /** The settlement's own result wording; narrated as one short paragraph. */
+  | { id: string; kind: 'result'; mandatory: boolean; visibility: FactVisibility; text: string };
+
+/** Whether the viewpoint could perceive the fact. Hidden facts are kept in the
+ * skeleton for evidence but are not narrated by default (`R11/R12`: the prose
+ * must not leak another room's business). */
+export type FactVisibility = 'scene' | 'hidden';
+
+export interface ScenePerson {
+  id: Id;
+  name: string;
+  /** Already-settled appearance text (initial + active changes), single line. */
+  note: string;
+  /** True for the viewpoint. */
+  viewpoint: boolean;
+}
+
+export interface SceneObject {
+  id: Id;
+  name: string;
+  note: string;
+}
+
+export interface SceneSkeleton {
+  anchor: {
+    worldId: Id; pointId: Id; version: number; stateDigest: string; previousPointId: Id | null;
+  };
+  viewpoint: {
+    id: Id; name: string; locationId: Id; location: string;
+    note: string; personality: string; sanity: number;
+  };
+  time: TimeAdvance | null;
+  place: { id: Id; name: string; note: string; parentName: string | null };
+  present: ScenePerson[];
+  objects: SceneObject[];
+  /** All settled facts of the point, scene and hidden. */
+  facts: SceneFact[];
+  /** Every registered name in the world. Used to reject names the prose pulled
+   * from pretraining instead of from this scene. */
+  worldNames: { characters: string[]; locations: string[]; items: string[] };
+  /** Names / places / items / quoted texts the prose may use. */
+  licensed: {
+    names: string[];
+    locations: string[];
+    items: string[];
+    /** Descriptive text already present in the settled state. */
+    details: string[];
+    /** Frozen texts (task goals, personality changes) that may be quoted. */
+    quotes: string[];
+  };
+  knowledge: SceneKnowledge;
+  priorText: string | null;
+  inputText: string | null;
+  resultsText: string | null;
+  /** False when only the fact packet (no full state) was available. */
+  hasSceneMaterial: boolean;
+  /** True when the point has no settled entity change (time-only). */
+  timeOnly: boolean;
+}
+
+/** Cross-turn knowledge the caller persists. Used only to avoid writing a
+ * re-discovery ("第一次看见") of something the viewpoint already knows. */
+export interface SceneKnowledge {
+  discoveredItemIds: Id[];
+  visitedLocationIds: Id[];
+  metCharacterIds: Id[];
+}
+
+export interface BeatDirective {
+  id: string;
+  index: number;
+  kind: 'open' | 'move' | 'event' | 'result' | 'scene' | 'close';
+  subject: { id: Id; name: string; viewpoint: boolean } | null;
+  /** Fact ids this beat must express. */
+  factIds: string[];
+  /** Detail strings this beat may use (already in `licensed.details`). */
+  details: string[];
+  /** Names the beat must contain (subject and/or destination). */
+  mustMention: string[];
+  /** Deterministic variation seed. */
+  seed: number;
+  minChars: number;
+  maxChars: number;
+}
+
+export interface BeatPlan {
+  beats: BeatDirective[];
+  /** Facts that are not narrated because the viewpoint cannot perceive them. */
+  hiddenFactIds: string[];
+  /** Facts deliberately left optional (scene texture) in this plan. */
+  optionalFactIds: string[];
+}
+
+export interface ComposeBeatRequest {
+  beat: BeatDirective;
+  scene: SceneSkeleton;
+  /** Accepted text of all previous beats; null for the first beat. */
+  prior: string | null;
+}
+
+export interface ComposeBeatOptions {
+  signal?: AbortSignal;
+  /** Real streaming delta for this beat (cumulative text). Program composers
+   * MUST NOT call this: a finished string is not a stream. */
+  onProgress?: (progress: { text: string; elapsedMs: number }) => void;
+}
+
+export interface ComposeBeatResult {
+  text: string;
+  /** Raw model output before cleanup, when a model wrote it. */
+  raw?: string;
+  source: 'program' | 'model' | 'external';
+  ms?: number;
+  attempts?: number;
+}
+
+/** Lane 07 (or any other composer) implements this. Duck-typed injection keeps
+ * the two lanes independent: no cross-lane import is required. */
+export type BeatComposer = (
+  request: ComposeBeatRequest,
+  options: ComposeBeatOptions,
+) => Promise<ComposeBeatResult>;
+
+export type CandidateIssueKind =
+  | 'fact_missing' | 'fact_actor_swap' | 'fact_direction_reversed' | 'fact_wrong_number'
+  | 'fact_time_wrong' | 'task_without_fact' | 'movement_without_fact'
+  | 'unlicensed_entity' | 'unlicensed_event' | 'rediscovery_claim'
+  | 'perspective_leak' | 'prompt_echo' | 'fact_list' | 'off_language' | 'empty_text' | 'too_short' | 'too_long'
+  | 'repeated_sentence' | 'echo_prior' | 'engine_error' | 'cancelled'
+  | 'beat_repaired' | 'beat_fallback' | 'sanity_direction_missing';
+
+export interface CandidateIssue {
+  kind: CandidateIssueKind;
+  severity: 'hard' | 'soft';
+  beatId: string | null;
+  detail: string;
+  sentence?: string;
+}
+
+export interface BeatEvidence {
+  beatId: string;
+  kind: BeatDirective['kind'];
+  source: 'program' | 'model' | 'external' | 'fallback';
+  text: string;
+  prompt: string | null;
+  raw: string | null;
+  attempts: number;
+  ms: number;
+  issues: CandidateIssue[];
+}
+
+export interface CandidateTimings {
+  totalMs: number;
+  planMs: number;
+  composeMs: number;
+  verifyMs: number;
+  beatsMs: number[];
+  firstTextMs: number | null;
+}
+
+export interface CandidateProgress {
+  text: string;
+  status: 'streaming' | 'accepted' | 'repaired' | 'rejected';
+  verified: boolean;
+  elapsedMs: number;
+  beatId: string | null;
+}
+
+/** Optional material the caller licenses beyond the settled state. Every entry
+ * is a description that already exists in the world; it is never used to
+ * invent an event. */
+export interface SceneHints {
+  placeNote?: string;
+  presentNotes?: Record<Id, string>;
+  objectNotes?: Record<Id, string>;
+  /** One line for the previous point's action, used only as continuity tone. */
+  previousAction?: string;
+}
+
+export interface ConstrainedPolicy {
+  /** Driver-level knobs (the shared browser driver forwards these names). */
+  maxTokens?: number;
+  temperature?: number;
+  /** Defaults to the world protagonist. */
+  viewpointId?: Id;
+  /** Read-only description overrides (all already settled). */
+  scene?: SceneHints;
+  knowledge?: Partial<SceneKnowledge>;
+  /** Settlement result text for this point, if the caller has it. Used only as
+   * extra licensed material for item/scene selection, never as a fact source. */
+  resultsText?: string | null;
+  /** Whether hidden (out-of-scene) facts may be narrated. Default false. */
+  narrateHiddenDeltas?: boolean;
+  /** 'program' never calls a model; 'model' uses the engine per beat;
+   * 'auto' uses the engine only when the policy enables it. */
+  mode?: 'program' | 'model' | 'auto';
+  /** Lane 07's composer. Takes precedence over the built-in model writer. */
+  composer?: BeatComposer;
+  /** Whether `mode: 'model'` may call the engine. Default true. */
+  enableModel?: boolean;
+  model?: {
+    maxTokensPerBeat?: number;
+    temperature?: number;
+    timeoutMs?: number;
+    maxAttempts?: number;
+    /** Extra instruction appended to every beat prompt (template adaptation). */
+    instruction?: string | null;
+    seed?: number;
+  };
+  /** 'direction' writes a felt change without the number; 'number' states the
+   * committed values explicitly (the legacy alignment gate expects this). */
+  sanityStyle?: 'direction' | 'number';
+  minChars?: number;
+  maxChars?: number;
+  /** Require the elapsed duration to be stated. Defaults to true for elapsed
+   * advances with amount > 0, false otherwise. */
+  requireTime?: boolean;
+  maxBeats?: number;
+  /** Whole-turn wall budget for model writing (default 180000 ms). Once it is
+   * spent, remaining beats are written by the program so the player still gets
+   * a readable turn instead of a timeout. */
+  turnTimeoutMs?: number;
+  seed?: number;
+  /** Strings the prose must not contain verbatim (hidden knowledge). */
+  forbiddenKnowledge?: string[];
+  /** Phrases used by previous accepted turns; the realizer avoids them. */
+  avoidOpenings?: string[];
+  /** Allow a constrained model to rewrite the final assembled text as one
+   * scene. Off by default: per-beat writing is the verifiable unit. */
+  polish?: boolean;
+}
+
+export interface GenerateCandidateInput {
+  engine: InferenceEngine;
+  /** Output of `projectConstrainedScene` (or a compatible packet). A packet
+   * without `state` still produces prose from the fact list alone. */
+  committed: CommittedScenePacket;
+  /** Caller-serialized model input (lane 01 projection). Licensed material:
+   * names inside it may appear in prose, and it is never re-parsed as state. */
+  inputText?: string | null;
+  priorText?: string | null;
+  signal?: AbortSignal;
+  onProgress?: (progress: CandidateProgress) => void;
+  policy?: ConstrainedPolicy;
+}
+
+/** `CommittedNarration` plus the raw reads the C route needs for scene
+ * material. The extra fields are optional so a facts-only packet still works. */
+export interface CommittedScenePacket extends CommittedNarration {
+  state?: WorldState;
+  beforeState?: WorldState | null;
+  timeAdvance?: TimeAdvance | null;
+  entityDeltas?: Record<Id, EntityDelta>;
+  /** Alternative serialized model input, when `inputText` is not passed. */
+  inputText?: string | null;
+  /** Alternative previous accepted text. */
+  priorText?: string | null;
+}
+
+export interface CandidateVerification {
+  ok: boolean;
+  coverage: { factId: string; kind: SceneFact['kind']; expressed: boolean; mandatory: boolean }[];
+  issues: CandidateIssue[];
+  unverifiedSentences: string[];
+  chars: number;
+  hiddenFactIds: string[];
+  repetition: number | null;
+}
+
+export interface CandidateResult {
+  text: string;
+  accepted: boolean;
+  /** Every beat, including repaired and fallback beats, with raw model output. */
+  rawAttempts: BeatEvidence[];
+  issues: CandidateIssue[];
+  timings: CandidateTimings;
+  strategyVersion: string;
+  status: 'accepted' | 'rejected' | 'cancelled' | 'error';
+  verification: CandidateVerification;
+  skeleton: SceneSkeleton | null;
+  plan: BeatPlan | null;
+  /** Which composer wrote each beat, in order. */
+  composers: string[];
+  /** Base fact packet for the legacy alignment gate (position/task/personality
+   * facts only; sanity uses this route's direction rule). */
+  basePacket: CommittedNarration | null;
+  display: CandidateProgress;
+}
+
+export type { Json, NarrationFact };

