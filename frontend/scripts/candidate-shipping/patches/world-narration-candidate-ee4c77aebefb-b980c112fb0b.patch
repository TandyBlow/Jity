+export interface CandidateResult {
+  text: string;
+  accepted: boolean;
+  rawAttempts: CandidateAttempt[];
+  attemptIndex: number | null;
+  status: CandidateStatus;
+  issues: CandidateIssue[];
+  timings: CandidateTimings;
+  strategyVersion: string;
