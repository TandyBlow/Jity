+    const current = merged[index];
+    const next = merged[index + 1];
+    const bareTime = /^(?:又?过了)?[零一二两三四五六七八九十百\d]+(?:分钟|秒|个小时|天|个月|年)(?:过去|之后)?。$/u.test(current);
