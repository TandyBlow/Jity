--- /dev/null
+++ b/frontend/src/lib/world-engine/local/narration-candidates/selection/runner.ts
@@ -0,0 +1,185 @@
+/** Narration candidate selection for the product page.
+ *
+ * The page sees ONE decision: did a candidate accept a scene for this point?
+ *   - `adopted`  → the candidate's verified prose is this point's narration;
+ *   - `fallback` → the existing in-model path keeps writing the text it writes
+ *                  today (the page already labels that text honestly).
+ *
+ * Selection order is internal configuration, never a player-visible option:
+ *   1. `globalThis.__jityNarrationCandidate` — QA/evaluation override, set by
+ *      scripts before the page boots; unset in normal play.
+ *   2. the `candidate` option the integrator passes;
+ *   3. `auto`, which only offers candidates marked `productDefault`.
+ *
+ * A candidate marked unavailable, that throws, or that rejects its own draft
+ * never becomes this point's narration. The user's cancel path is the engine's
+ * own; this runner adds no second truth and no hidden retry loop.
+ */
+import type {
+  CandidateNarrationResult, NarrationCandidate, NarrationPoint, NarrationProgress,
+  NarrationRunResult, NarrationRunner, NarrationRunnerOptions, PreparedNarration, ProgramFallback,
+} from './types';
+import { prepareNarration } from './projection';
+import { TRAINED_CANDIDATE } from './trained';
+import { CONSTRAINED_CANDIDATE } from './constrained';
+
+/** Candidates that exist in this tree. A/C adapters are added here when their
+ * entry modules land; nothing else in the product has to change. */
+export const SHIPPED_CANDIDATES: NarrationCandidate[] = [TRAINED_CANDIDATE, CONSTRAINED_CANDIDATE];
+
+/** QA override. Internal: the page never renders or documents this name. */
+export function internalCandidateOverride(): string | null {
+  const value = (globalThis as { __jityNarrationCandidate?: unknown }).__jityNarrationCandidate;
+  return typeof value === 'string' && value.trim().length > 0 ? value.trim() : null;
+}
+
+const printable = (error: unknown): string => (error instanceof Error ? `${error.name}:${error.message}` : String(error));
+
+function summarize(result: CandidateNarrationResult): string {
+  if (result.accepted) return '';
+  const kinds = result.issues.filter((issue) => issue.severity === 'hard').map((issue) => issue.kind);
+  return [result.reason ?? result.status, kinds.length ? kinds.join('+') : null].filter(Boolean).join('|');
+}
+
+export function createNarrationRunner(options: NarrationRunnerOptions): NarrationRunner {
+  const candidates = options.candidates ?? SHIPPED_CANDIDATES;
+  const requested = internalCandidateOverride() ?? options.candidate ?? 'auto';
+  const productDefault = candidates.find((candidate) => candidate.productDefault)?.id ?? null;
+  const limits = {
+    temperature: options.temperature,
+    retryTemperature: options.retryTemperature,
+    maxTokens: options.maxTokens,
+    maxTokensCeiling: options.maxTokensCeiling,
+    timeoutMs: options.timeoutMs,
+    deadlineMs: options.deadlineMs,
+    minChars: options.minChars,
+    targetChars: options.targetChars,
+  };
+
+  const ordered = (): NarrationCandidate[] => {
+    if (requested === 'builtin') return [];
+    if (requested === 'auto') return candidates.filter((candidate) => candidate.productDefault);
+    return candidates.filter((candidate) => candidate.id === requested);
+  };
+
+  return {
+    selection: {
+      requested,
+      available: candidates.map((candidate) => candidate.id),
+      productDefault,
+    },
+    async generateProgram(point: NarrationPoint): Promise<ProgramFallback | null> {
+      // The in-model writer already tried and failed before this is called, so
+      // the world-opening guard does not apply: a readable program scene is
+      // better than the terse factual draft, and it is labelled as a downgrade.
+      if (!point.after) return null;
+      let prepared: PreparedNarration;
+      try {
+        prepared = prepareNarration(point, limits);
+      } catch {
+        return null;
+      }
+      const candidate = candidates.find((entry) => entry.id === 'constrained') ?? CONSTRAINED_CANDIDATE;
+      try {
+        const result = await candidate.run({
+          engine: options.engine, point, prepared,
+          policy: { mode: 'program' },
+        });
+        if (!result.accepted || result.text.trim().length === 0) return null;
+        return {
+          text: result.text,
+          strategyVersion: result.strategyVersion,
+          timings: result.timings,
+          issues: result.issues,
+        };
+      } catch {
+        return null;
+      }
+    },
+    async generate(point: NarrationPoint, onProgress?: (progress: NarrationProgress) => void): Promise<NarrationRunResult> {
+      const plan = ordered();
+      if (plan.length === 0) {
+        return {
+          kind: 'fallback',
+          candidateId: null,
+          grade: 'program_fallback',
+          reason: requested === 'auto' ? 'no_product_candidate' : requested === 'builtin' ? 'builtin_requested' : `unknown_candidate:${requested}`,
+          notice: null,
+        };
+      }
+      let prepared: PreparedNarration;
+      try {
+        prepared = prepareNarration(point, limits);
+      } catch (error) {
+        return {
+          kind: 'fallback', candidateId: null, grade: 'program_fallback',
+          reason: `prepare_error:${printable(error)}`, notice: null,
+        };
+      }
+      const problems: string[] = [];
+      let last: CandidateNarrationResult | null = null;
+      for (const candidate of plan) {
+        const availability = candidate.availability(point, prepared);
+        if (!availability.available) {
+          problems.push(`unavailable:${candidate.id}|${availability.reason ?? 'unknown'}`);
+          continue;
+        }
+        let result: CandidateNarrationResult;
+        try {
+          result = await candidate.run({
+            engine: options.engine, point, prepared, onProgress,
+            ...(candidate.route === 'constrained'
+              ? { policy: { mode: options.constrainedMode ?? 'program' } }
+              : candidate.route === 'trained'
+                ? { policy: { sceneMode: options.trainedMode ?? 'beats' } }
+                : {}),
+          });
+        } catch (error) {
+          problems.push(`error:${candidate.id}|${printable(error)}`);
+          continue;
+        }
+        last = result;
+        if (result.accepted && result.text.trim().length > 0) {
+          return {
+            kind: 'adopted',
+            candidateId: result.candidateId,
+            route: result.route,
+            text: result.text,
+            accepted: true,
+            grade: result.grade === 'program' ? 'program' : 'candidate',
+            issues: result.issues,
+            timings: result.timings,
+            promptChars: result.promptChars,
+            strategyVersion: result.strategyVersion,
+            attempts: result.attempts,
+            detail: result.detail ?? null,
+            completion: {
+              raw: result.text,
+              finishReason: 'stop',
+              firstTokenMs: result.timings.firstTokenMs,
+              wallMs: result.timings.totalMs,
+            },
+          };
+        }
+        problems.push(`${result.status}:${candidate.id}|${summarize(result)}`);
+      }
+      return {
+        kind: 'fallback',
+        candidateId: plan[0]?.id ?? null,
+        grade: 'program_fallback',
+        reason: problems.join(';') || 'candidate_rejected',
+        notice: null,
+        detail: last ? {
+          candidateId: last.candidateId,
+          status: last.status,
+          text: last.text,
+          issues: last.issues,
+          timings: last.timings,
+          strategyVersion: last.strategyVersion,
+          attempts: last.attempts,
+          candidate: last.detail ?? null,
+        } : undefined,
+      };
+    },
+  };
+}

diff --git a/frontend/src/lib/world-engine/local/narration-candidates/selection/trained.ts b/frontend/src/lib/world-engine/local/narration-candidates/selection/trained.ts
new file mode 100644
--- /dev/null
+++ b/frontend/src/lib/world-engine/local/narration-candidates/selection/trained.ts
@@ -0,0 +1,114 @@
+/** B-route adaptation: lane 02's committed-fact narration strategy (beats).
+ *
+ * The strategy owns prompt construction, verification and repair. This adapter
+ * only supplies:
+ *   - the fact packet (projected from the sealed delta by `projection.ts`),
+ *   - lane 01's serialized input (licensing evidence; beats do not re-use it
+ *     as the prompt),
+ *   - the writing policy (viewpoint, roster, time, lengths, temperature),
+ *   - real progress increments and the final verdict, unmapped and unedited.
+ *
+ * `productDefault` stays false until a real-model evidence record shows at
+ * least one accepted narration; the selection layer never promotes a candidate
+ * on unit-test evidence alone.
+ */
+import { generateCandidate, NARRATION_STRATEGY_VERSION } from '../../narration-generation';
+import type { NarrationIssue } from '../../narration-generation/types';
+import type { CandidateNarrationResult, NarrationCandidate } from './types';
+
+const hardKinds = (issues: NarrationIssue[]): string[] =>
+  [...new Set(issues.filter((issue) => issue.severity === 'hard').map((issue) => issue.kind))];
+
+export const TRAINED_CANDIDATE: NarrationCandidate = {
+  id: 'trained',
+  route: 'trained',
+  version: `trained-beats:${NARRATION_STRATEGY_VERSION}`,
+  label: '02-narration · committed-fact beats',
+  requires: {
+    modules: ['local/narration-generation', 'local/narration-input'],
+    template: 'engine chat template (no manual ChatML wrap)',
+  },
+  productDefault: false,
+  availability(_point, prepared) {
+    if (!prepared.inputText) {
+      return { available: false, reason: `input_unavailable:${prepared.inputError ?? 'empty'}` };
+    }
+    return { available: true, reason: null };
+  },
+  async run({ engine, point, prepared, onProgress, policy: runPolicy }): Promise<CandidateNarrationResult> {
+    const result = await generateCandidate({
+      engine,
+      committed: prepared.facts,
+      inputText: prepared.inputText ?? '',
+      priorText: point.priorText ?? null,
+      signal: point.signal,
+      onProgress: (state) => onProgress?.({
+        text: state.text, elapsedMs: state.elapsedMs, verified: state.verified, attempt: state.attempt,
+      }),
+      policy: {
+        ...prepared.policy,
+        mode: runPolicy?.sceneMode === 'scene' ? 'scene' : 'beats',
+        scene: prepared.scene,
+        // Scene mode otherwise writes a static tableau: the page model omitted
+        // the settled move and the elapsed time and was rejected for it. This
+        // is a constraint, not a fact: the model still reads the sealed delta.
+        ...(runPolicy?.sceneMode === 'scene'
+          ? { instruction: '正文必须写出【变化】里的移动和这段时间的推进；不要新增人物、物品、事件或往事。' }
+          : {}),
+      },
+    });
+    const issues = result.issues.map((issue) => ({
+      kind: issue.kind,
+      severity: issue.severity,
+      attempt: issue.attempt,
+    }));
+    const allFellBack = result.beats.length > 0 && result.beats.every((beat) => beat.source !== 'model');
+    const hard = hardKinds(result.issues);
+    const reason = result.accepted
+      ? null
+      : result.status === 'cancelled' ? 'cancelled'
+        : result.status === 'timeout' ? 'timeout'
+          : `rejected:${hard.join('+') || 'unknown'}`;
+    return {
+      candidateId: 'trained',
+      route: 'trained',
+      text: result.text,
+      accepted: result.accepted && result.text.trim().length > 0,
+      grade: result.accepted ? 'candidate' : allFellBack ? 'program' : 'candidate_unverified',
+      status: result.status,
+      reason,
+      issues,
+      attempts: result.rawAttempts.length,
+      promptChars: result.rawAttempts.reduce((sum, attempt) => sum + attempt.promptChars, 0),
+      timings: {
+        totalMs: result.timings.totalMs,
+        attemptMs: result.timings.attemptMs,
+        firstTokenMs: result.timings.firstTokenMs,
+      },
+      strategyVersion: result.strategyVersion,
+      allFellBack,
+      detail: {
+        mandatory: prepared.mandatoryFactIds,
+        beats: result.beats.map((beat) => ({
+          id: beat.beatId, kind: beat.kind, source: beat.source, attempts: beat.attempts,
+          durationMs: beat.durationMs, text: beat.text,
+          issues: beat.issues.map((issue) => `${issue.severity}:${issue.kind}`),
+        })),
+        assembly: result.assembly,
+        // Raw engine output per attempt. Truncated for the evidence file; the
+        // prompt is already recorded per beat inside the strategy's evidence.
+        attemptsEvidence: result.rawAttempts.map((attempt) => ({
+          attempt: attempt.attempt,
+          promptChars: attempt.promptChars,
+          durationMs: attempt.durationMs,
+          firstTokenMs: attempt.firstTokenMs,
+          finishReason: attempt.finishReason,
+          error: attempt.error,
+          raw: attempt.raw.slice(0, 1200),
+          cleaned: attempt.cleaned.slice(0, 600),
+          issues: attempt.issues.map((issue) => `${issue.severity}:${issue.kind}`),
+        })),
+      },
+    };
+  },
+};

diff --git a/frontend/src/lib/world-engine/local/narration-candidates/selection/types.ts b/frontend/src/lib/world-engine/local/narration-candidates/selection/types.ts
