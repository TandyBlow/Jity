diff --git a/frontend/src/lib/world-engine/local/session-recovery.test.ts b/frontend/src/lib/world-engine/local/session-recovery.test.ts
index 02beaaa8..f9fc237e 100644
--- a/frontend/src/lib/world-engine/local/session-recovery.test.ts
+++ b/frontend/src/lib/world-engine/local/session-recovery.test.ts
@@ -598,4 +598,35 @@ describe('LocalGameSession durability', () => {
     expect((await store.loadLegacyBackup(corrupt.backupKey!))?.raw).toBe('{not json');
     expect((await store.load(legacySession.worldId))!.metadata.revision).toBe(1);
   });
+
+  it('a refresh after a concluded round plans the next command again', async () => {
+    const store = createLocalProgressStore(new MemoryProgressBackend());
+    const session = await LocalGameSession.create(template(), scriptedModel([]), {
+      storage: store, sessionId: 'tab_a', leaseHeartbeat: false, roll: () => 13,
+    });
+    await session.start();
+    expect((await session.submit('我打开盒盖。')).kind).not.toBe('error');
+    await session.close();
+
+    // Older saves can carry a checkpoint captured before the conclusion whose
+    // plan is fully consumed; restoring it must not make the next command wait
+    // on an empty plan.
+    const saved = await store.load(session.worldId);
+    const point = Object.values(saved!.snapshot.transport.points)[0];
+    const legacyCheckpoint = {
+      roundId: point.roundId,
+      plan: [{ pointId: point.id, kind: point.kind, timeAdvance: point.timeAdvance, actorIds: [...saved!.snapshot.transport.round!.order] }],
+      planIndex: 1,
+    };
+    await store.save(session.worldId, { ...saved!.snapshot, checkpoint: legacyCheckpoint });
+
+    const restored = await LocalGameSession.restoreFromStore(store, session.worldId, scriptedModel([]), {
+      sessionId: 'tab_b', leaseHeartbeat: false, roll: () => 13,
+    });
+    expect(restored).not.toBeNull();
+    const next = await restored!.submit('我退回走廊。');
+    expect(next.kind).not.toBe('error');
+    expect(restored!.commandsPlayed).toEqual(['我打开盒盖。', '我退回走廊。']);
+    expect(Object.keys(restored!.snapshot.transport.points)).toHaveLength(2);
+  });
 });
