+export function joinText(parts: { text: string }[], minChars = 0): string {
+  const texts = parts.map((part) => part.text.trim()).filter(Boolean);
+  const joined = texts.join('\n\n');
+  // A short program scene reads as one paragraph in the reviewed corpus
+  // (61-158 chars, single paragraph). Blank lines only separate long scenes,
+  // and joining must not push the scene below the caller's length floor.
+  if ([...joined].length > 158) return joined;
+  const single = texts.join('').replace(/\n{2,}/gu, '');
+  return [...single].length >= minChars ? single : joined;
 }
 
